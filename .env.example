# Copy this file as .env and fill it in. The real .env is in .gitignore.
OMNIOPS_EMAIL=admin@example.com
OMNIOPS_PASSWORD=changeme

# --- Optional, machine/environment-specific overrides (defaults in shared/config/settings.py) ---
# OmniOps base URL to test against.
# BASE_URL=http://localhost:5173
# Python interpreter used to run the edge script (tools/sim_launcher.py).
# EDGE_PYTHON=C:\path\to\python.exe
# Path to the simulator/edge repo (omniops-bess-edge), if not a sibling folder.
# SIM_REPO_DIR=C:\path\to\omniops-bess-edge
# True = run the browser headless (no visible window); useful in CI.
# HEADLESS=false
# Take a screenshot of the dashboard when a FAILURE first appears.
# CAPTURE_FAILURES=true
