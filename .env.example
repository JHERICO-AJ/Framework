# Copy this file as .env and fill it in. The real .env is in .gitignore.
# Login page offers BOTH a native form and "Sign in with Microsoft" (see
# framework_ui/pages/auth/login_page.py). Default is Microsoft SSO -- these
# credentials must match whichever method LOGIN_METHOD below picks.
OMNIOPS_EMAIL=you@yourcompany.com
OMNIOPS_PASSWORD=changeme
# LOGIN_METHOD=microsoft   # or "native" -- see login_page.py

# --- Optional, machine/environment-specific overrides (defaults in shared/config/settings.py) ---
# OmniOps base URL to test against. Pick ONE (comment out the other) — the
# default if you set neither is localhost (the simulator/proxy/edge stack).
# BASE_URL=http://localhost:5173
# BASE_URL=https://amax-omniops-qa-linux-grepa4ergac5b9bh.centralus-01.azurewebsites.net
# Python interpreter used to run the edge script (tools/sim_launcher.py).
# EDGE_PYTHON=C:\path\to\python.exe
# Path to the simulator/edge repo (omniops-bess-edge), if not a sibling folder.
# SIM_REPO_DIR=C:\path\to\omniops-bess-edge
# True = run the browser headless (no visible window); useful in CI.
# HEADLESS=false
# Take a screenshot of the dashboard when a FAILURE first appears.
# CAPTURE_FAILURES=true
# Timeout (seconds) applied to every HTTP request made by ApiClient/auth.
# HTTP_TIMEOUT_S=10

# --- DB (optional, only needed for cross-layer tests -- tests/conftest.py: db_conn) ---
# Read-only Postgres connection. If unset, cross-layer tests SKIP (like
# require_omniops does when OmniOps isn't reachable) instead of failing.
# Prefer a read-only DB role here if one exists -- these tests only SELECT.
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_NAME=your-db-name
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password
